# Copia este archivo como .env (no se sube a git) y rellena los valores.
# docker compose lo lee automaticamente.

# ---------------------------------------------------------------------------
# Desarrollo y produccion

# Clave para firmar los JWT: cadena aleatoria de al menos 32 caracteres
# Puedes generarla con: openssl rand -base64 48
JWT_SECRET=

# ---------------------------------------------------------------------------
# Solo produccion (docker-compose.prod.yaml). En desarrollo no hace falta nada mas:
# la base de datos usa postgres/postgres y el correo va a mailpit

# Dominio de la app, sin https:// (ej. lightweight.tudominio.es). Su registro DNS A debe
# apuntar a la IP del servidor antes de arrancar, para que Caddy pueda sacar el certificado
DOMAIN=

# Contrasena de Postgres. Generala con: openssl rand -base64 32
POSTGRES_PASSWORD=

# Version de las imagenes de ghcr.io que se despliega (por defecto latest)
# IMAGE_TAG=

# Correo (SMTP con STARTTLS, puerto 587). El remitente es SMTP_FROM, o SMTP_USERNAME si se deja vacio
#
# IONOS (buzon del dominio):
#   SMTP_HOST=smtp.ionos.es   (compruebalo en el panel de IONOS)
#   SMTP_USERNAME=noreply@tudominio.es
#   SMTP_PASSWORD=la contrasena del buzon
#
# Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_USERNAME=tu direccion de Gmail (Gmail solo deja enviar desde la propia cuenta)
#   SMTP_PASSWORD=una contrasena de aplicacion, no la de tu cuenta:
#     1. Activa la verificacion en dos pasos en tu cuenta de Google
#     2. https://myaccount.google.com/apppasswords -> crea una para "LightWeight"
#     3. Copia los 16 caracteres sin espacios
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---------------------------------------------------------------------------
# Copias de la BD fuera del servidor (deploy/backup.sh, solo produccion)

# Remoto de rclone y carpeta donde se suben (ej. b2:lightweight-backups). Se configura con "rclone config"
BACKUP_REMOTE=
# Clave PUBLICA de age (age1...). La privada no va en el servidor: va en el gestor de contrasenas
BACKUP_AGE_RECIPIENT=
# Opcional: URL de healthchecks.io. Si un dia no llega la copia, te avisa por correo
BACKUP_PING_URL=
