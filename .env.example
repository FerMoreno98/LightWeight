# Copia este archivo como .env (no se sube a git) y rellena los valores.
# docker compose lo lee automaticamente.

# Clave para firmar los JWT: cadena aleatoria de al menos 32 caracteres
# Puedes generarla con: openssl rand -base64 48
JWT_SECRET=

# ---------------------------------------------------------------------------
# Produccion: correo con Gmail (en desarrollo se usa mailpit y no hace falta nada)
# docker-compose.prod.yaml los pasa como Smtp__Username / Smtp__Password / Smtp__From,
# con Smtp__Host=smtp.gmail.com, Smtp__Port=587 y Smtp__EnableSsl=true
#
# La contrasena NO es la de tu cuenta, es una contrasena de aplicacion:
#   1. Activa la verificacion en dos pasos en tu cuenta de Google
#   2. https://myaccount.google.com/apppasswords -> crea una para "LightWeight"
#   3. Copia los 16 caracteres (sin espacios) en SMTP_PASSWORD
# Gmail solo deja enviar desde la propia cuenta: el remitente sera SMTP_USERNAME
SMTP_USERNAME=
SMTP_PASSWORD=
